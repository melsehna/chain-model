# HTCondor submit file for main parameter sweep
#
# Sweeps d_WtEdge across super-MIC range for two values of l:
#   l=100  -> biofilm (core present)
#   l=2000 -> well-mixed (core never forms; l >= nInit)
#
# Both use the same chainModel.py, so the comparison is exact.
#
# Usage:
#   python genSweepMainJobs.py
#   condor_submit sweepMain.sub

universe = vanilla
executable = runBatch.sh

request_cpus = 1
request_memory = 512MB
request_disk = 200MB

+JobDurationCategory = "Medium"
+ProjectName = "PLACEHOLDER_PROJECT"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = chainModel.py, runBatch.py

output = logs/main_$(Cluster).$(Process).out
error  = logs/main_$(Cluster).$(Process).err
log    = logs/main_$(Cluster).$(Process).log

# Arguments: l dose seedStart seedCount mu bCoreRatio outFile
arguments = $(lVal) $(dose) $(seedStart) 200 1e-4 0.2 main_l$(lVal)_dose$(dose)_s$(seedStart).csv
transfer_output_files = main_l$(lVal)_dose$(dose)_s$(seedStart).csv
transfer_output_remaps = "main_l$(lVal)_dose$(dose)_s$(seedStart).csv = results/main_l$(lVal)_dose$(dose)_s$(seedStart).csv"

queue lVal, dose, seedStart from sweepMainJobs.txt
