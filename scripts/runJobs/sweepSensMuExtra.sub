# HTCondor submit file for §6 sensMu targeted boost.
#
# Boosts the 3 conditions × 3 mu values × 8 doses sensitivity sweep from
# 5000 to 20000 seeds per (condition, mu, dose) combination (seeds
# 5000-19799 in 75 batches of 200). Output files land under sensMu_
# prefix in results/.
#
# Generate sensMuExtraJobs.txt first:  python genSensExtraJobs.py
# Then submit:                         condor_submit sweepSensMuExtra.sub

universe   = vanilla
executable = runBatch.sh

request_cpus   = 1
request_memory = 1024MB
request_disk   = 200MB

requirements             = (Arch == "X86_64")
+JobDurationCategory     = "Medium"
+ProjectName             = "EvolSims"
+SingularityImage        = "/cvmfs/singularity.opensciencegrid.org/htc/rocky:9"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = ../../src/chainModel.py, ../../src/wellMixed.py, runBatch.py

max_retries = 3
on_exit_hold        = (ExitBySignal == True) || (ExitCode != 0)
on_exit_hold_reason = strcat("Job failed: ExitCode=", ExitCode, " ExitBySignal=", ExitBySignal)
periodic_release    = (NumJobStarts < JobMaxRetries) && ((CurrentTime - EnteredCurrentStatus) > 600)

output = logs/sensMuExtra_$(Cluster).$(Process).out
error  = logs/sensMuExtra_$(Cluster).$(Process).err
log    = logs/sensMuExtra_$(Cluster).$(Process).log

arguments              = $(condition) $(dose) $(seedStart) 200 $(mu) 0.2 sensMu_$(condition)_dose$(dose)_mu$(mu)_s$(seedStart).csv
transfer_output_files  = sensMu_$(condition)_dose$(dose)_mu$(mu)_s$(seedStart).csv
transfer_output_remaps = "sensMu_$(condition)_dose$(dose)_mu$(mu)_s$(seedStart).csv = results/sensMu_$(condition)_dose$(dose)_mu$(mu)_s$(seedStart).csv"

queue condition, dose, seedStart, mu from sensMuExtraJobs.txt
