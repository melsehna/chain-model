# HTCondor submit file for core dormancy sensitivity
#
# Runs chain model with l=100 (biofilm) across multiple bCoreRatio values.
# The well-mixed comparison reuses main sweep's l=2000 data.

universe = vanilla
executable = runBatch.sh

request_cpus = 1
request_memory = 512MB
request_disk = 200MB

+JobDurationCategory = "Medium"
+ProjectName = "PLACEHOLDER_PROJECT"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = chainModel.py, runBatch.py

output = logs/sensCore_$(Cluster).$(Process).out
error  = logs/sensCore_$(Cluster).$(Process).err
log    = logs/sensCore_$(Cluster).$(Process).log

# Fixed l=100 (biofilm); vary bCoreRatio
arguments = 100 $(dose) $(seedStart) 200 1e-4 $(bCore) sensCore_dose$(dose)_bCore$(bCore)_s$(seedStart).csv
transfer_output_files = sensCore_dose$(dose)_bCore$(bCore)_s$(seedStart).csv
transfer_output_remaps = "sensCore_dose$(dose)_bCore$(bCore)_s$(seedStart).csv = results/sensCore_dose$(dose)_bCore$(bCore)_s$(seedStart).csv"

queue dose, seedStart, bCore from sensitivityCoreJobs.txt
