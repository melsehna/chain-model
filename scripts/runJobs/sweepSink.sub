# Graveyard test: interior active, mutation inside switched off (--muCore 0).
#   densityForm = step, K = nInit, kEst = 8, matching the fx* sweeps
# c = 0 is not run here; those points are the fxCore sweep, and the well-mixed
# reference is fxMain (cost-free by construction, having no core).
#
# Generate args first:  python3 genCostJobs.py
# Then submit:          condor_submit sweepCost.sub

universe   = vanilla
executable = snapshots/sink/runBatch.sh

request_cpus   = 1
request_memory = 1024MB
request_disk   = 200MB

requirements             = (Arch == "X86_64")
+JobDurationCategory     = "Medium"
+ProjectName             = "EvolSims"
+SingularityImage        = "/cvmfs/singularity.opensciencegrid.org/htc/rocky:9"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = snapshots/sink/chainModel.py, snapshots/sink/wellMixed.py, snapshots/sink/runBatch.py

max_retries = 3
on_exit_hold        = (ExitBySignal == True) || (ExitCode != 0)
on_exit_hold_reason = strcat("Job failed: ExitCode=", ExitCode, " ExitBySignal=", ExitBySignal)
periodic_release    = (NumJobStarts < JobMaxRetries) && ((CurrentTime - EnteredCurrentStatus) > 600)

output = logs/sink_$(Cluster).$(Process).out
error  = logs/sink_$(Cluster).$(Process).err
log    = logs/sink_$(Cluster).$(Process).log

# condition dose seedStart seedCount mu bCoreRatio outFile l K densityForm [extra flags]
arguments              = biofilm $(dose) $(seedStart) 200 1e-4 $(bCore) fxSink_$(tag)_dose$(dose)_s$(seedStart).csv 100 1000 step --kEst 8 --muCore 0
transfer_output_files  = fxSink_$(tag)_dose$(dose)_s$(seedStart).csv
transfer_output_remaps = "fxSink_$(tag)_dose$(dose)_s$(seedStart).csv = results/fxSink_$(tag)_dose$(dose)_s$(seedStart).csv"

queue dose, seedStart, bCore, tag from sinkJobs.txt
