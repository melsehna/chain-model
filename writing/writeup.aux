\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textit  {Left:} Upper bound $1 - e^{-\Lambda }$ on rescue probability vs.\ dose, for several values of $b_c$. The dashed black line is the well-mixed baseline; the dotted $b_c = 0$ curve lies exactly on top of it. \textit  {Right:} Mutation-supply ratio $\Lambda _{\text  {BF}}/\Lambda _{\text  {WM}}$ vs.\ $b_c$. The ratio is linear in $b_c$ and completely independent of dose.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:lambda}{{1}{6}{\textit {Left:} Upper bound $1 - e^{-\Lambda }$ on rescue probability vs.\ dose, for several values of $b_c$. The dashed black line is the well-mixed baseline; the dotted $b_c = 0$ curve lies exactly on top of it. \textit {Right:} Mutation-supply ratio $\Lambda _{\text {BF}}/\Lambda _{\text {WM}}$ vs.\ $b_c$. The ratio is linear in $b_c$ and completely independent of dose}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Core delivery: the race between drift and boundary retreat}{6}{subsection.2.2}\protected@file@percent }
\newlabel{sec:delivery}{{2.2}{6}{Core delivery: the race between drift and boundary retreat}{subsection.2.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Survival to delivery.}{6}{section*.6}\protected@file@percent }
\newlabel{eq:survival}{{5}{6}{Survival to delivery}{equation.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Net delivery rate.}{7}{section*.7}\protected@file@percent }
\newlabel{eq:gamma}{{6}{7}{Net delivery rate}{equation.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textit  {Left:} Core-delivery rate $\Gamma _{\text  {core}}/\mu $ vs.\ dose. Solid curves: actual rate accounting for drift losses (Equation~\eqref  {eq:gamma}). Dotted horizontal lines: naive upper limit if every core mutation survived to delivery. The gap between them is the fraction lost to drift; it is largest at low dose (slow boundary retreat, large $\alpha $). \textit  {Right:} Drift-survival probability $\ln (1+\alpha )/\alpha $ vs.\ $\alpha $. Below $\alpha = 1$ (left of the dotted vertical line) the core is an efficient nursery; above $\alpha = 1$ most lineages are lost before delivery.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:delivery}{{2}{7}{\textit {Left:} Core-delivery rate $\Gamma _{\text {core}}/\mu $ vs.\ dose. Solid curves: actual rate accounting for drift losses (Equation~\eqref {eq:gamma}). Dotted horizontal lines: naive upper limit if every core mutation survived to delivery. The gap between them is the fraction lost to drift; it is largest at low dose (slow boundary retreat, large $\alpha $). \textit {Right:} Drift-survival probability $\ln (1+\alpha )/\alpha $ vs.\ $\alpha $. Below $\alpha = 1$ (left of the dotted vertical line) the core is an efficient nursery; above $\alpha = 1$ most lineages are lost before delivery}{figure.2}{}}
\newlabel{eq:crossover}{{7}{7}{Net delivery rate}{equation.7}{}}
